@model IEnumerable<PrefinalExamApp.Models.ExamQuestions>

@{
    ViewData["Title"] = "Prefinals Examination";
}

<!-- Google Fonts owo -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jersey+20&display=swap" rel="stylesheet">

<!-- Header navigation bar -->
<div id="top"></div>
<div class="page-title-banner">Prefinal Exam Answers!!! :3</div>

<main class="uni-container">
    <section>
        <h1>IT ELECTIVE 2</h1>
        <h2>i had a few more minutes so i decided to make the site look pretty</h2>
        <h4>shoutout to my friend for letting me take inspiration from his site :3</h4>
    </section>

    <!-- Student details banner -->
    <div class="student-strip">
        <div><strong>STUDENT:</strong> Stephen Rhane L. Magnayon</div>
        <div><strong>SECTION:</strong> BSIT 31E2</div>
    </div>

    <!-- Questions list -->
    @foreach (var q in Model)
    {
        <section class="question-block" id="q-@q.Id">
            <h3>Question #@q.Id (Answer: @q.CorrectAnswer)</h3>
            <p class="question-prompt">@q.Question</p>

            <ul class="options-list">
                @foreach (var opt in q.Options)
                {
                    bool isCorrect = opt.StartsWith(q.CorrectAnswer + " -");
                    <li class="option-item @(isCorrect ? "selected-answer" : "")">
                        @(isCorrect ? "★ " : "○ ") @opt
                    </li>
                }
            </ul>

            <div class="explanation-box">
                <strong>why:</strong> @q.Explanation
            </div>
        </section>
    }
</main>